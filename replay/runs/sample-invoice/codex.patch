diff --git a/invoice/totals.py b/invoice/totals.py
index 5a33ffc..9e11826 100644
--- a/invoice/totals.py
+++ b/invoice/totals.py
@@ -1,11 +1,18 @@
 """Invoice totals for the payments service."""
 
+from decimal import Decimal, ROUND_HALF_UP
+
 
 def line_total(quantity, unit_price):
     return quantity * unit_price
 
 
 def invoice_total(lines, tax_rate=0.0):
-    """Sum of line totals plus tax, rounded to cents."""
-    subtotal = sum(line_total(q, p) for q, p in lines)
-    return round(subtotal * (1 + tax_rate), 2)
+    """Sum of line totals plus tax, rounded half-up to cents as a float."""
+    # Convert inputs before arithmetic to avoid binary float rounding errors.
+    subtotal = sum(
+        (line_total(Decimal(str(q)), Decimal(str(p))) for q, p in lines),
+        Decimal("0"),
+    )
+    total = subtotal * (Decimal("1") + Decimal(str(tax_rate)))
+    return float(total.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP))
