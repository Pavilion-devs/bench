+++ b/tests/test_totals.py
@@ -7,3 +7,18 @@ def test_line_total():
 
 def test_invoice_total_without_tax():
     assert invoice_total([(1, 10.0), (2, 2.5)]) == 15.0
+
+
+def test_invoice_total_rounds_half_cent_up():
+    assert invoice_total([(1, 2.675)]) == 2.68
+    assert invoice_total([(1, 1.005)]) == 1.01
+    assert invoice_total([(1, 0.125)]) == 0.13
+
+
+def test_invoice_total_rounds_half_cent_up_after_tax():
+    # 2.50 * 1.07 = 2.675 exactly
+    assert invoice_total([(1, 2.5)], tax_rate=0.07) == 2.68
+
+
+def test_invoice_total_rounds_below_half_down():
+    assert invoice_total([(1, 2.674)]) == 2.67
